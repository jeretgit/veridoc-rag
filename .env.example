# ===== Database =====
POSTGRES_DB=veridoc
POSTGRES_USER=veridoc
POSTGRES_PASSWORD=veridoc123
POSTGRES_PORT=5432

# ===== Backend (Java) =====
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/veridoc
SPRING_DATASOURCE_USERNAME=veridoc
SPRING_DATASOURCE_PASSWORD=veridoc123

# ===== Frontend (Angular) =====
FRONTEND_PORT=4200

# ===== AI Service (Python) =====
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database URL used by the Python service (psycopg / pgvector)
DATABASE_URL=postgresql://veridoc:veridoc123@postgres:5432/veridoc

# ===== Embedding & chunking =====
EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ===== Chat & retrieval (grounded Q&A) =====
CHAT_MODEL=llama3.1:8b
# Number of chunks retrieved per question
TOP_K=5
# Minimum cosine similarity (0~1) a chunk must reach to be used as context
MIN_SIMILARITY_SCORE=0.35

# ===== OpenAI Compatible (cloud demo mode) =====
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
